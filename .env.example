# ============================================================
# NFCC Platform - Environment Variables Template
# ============================================================
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to git!

NFCC_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8000

API_KEY=replace_me_with_secure_key
JWT_SECRET_KEY=replace_me_with_secure_key

# Optional second, stronger secret required (in addition to API_KEY)
# specifically to approve, dismiss, or retract a REAL (non-exercise)
# pending alert (src/api/auth.py's enforce_approval_key) - narrows the
# blast radius of API_KEY alone, which is otherwise used for every read
# and write on this platform. Leave unset to keep today's behavior
# (API_KEY alone is sufficient everywhere, including alert approval) -
# this is additive and never a silent new requirement. If set, the
# dashboard needs the matching NFCC_ALERT_APPROVAL_KEY value in its own
# Streamlit Cloud secrets to keep working.
ALERT_APPROVAL_KEY=

# Twilio WhatsApp - a citizen texts the sandbox/production number to
# both report floods (src/api/routes/whatsapp_webhook.py) and opt into
# outbound alerts (src/community/alert_subscription_commands.py).
# ALERT_WHATSAPP_RECIPIENTS is optional/additive - real per-district
# recipients now come from a citizen replying "ALERTS ON <district>",
# not just this static list (src/database/channel_subscriptions_db.py).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_RECIPIENTS=whatsapp:+233XXXXXXXXX

# Telegram - a second, always-free reporting/alerts channel alongside
# WhatsApp (src/api/routes/telegram_webhook.py). Token from @BotFather;
# webhook secret is any string you choose, passed to Telegram's
# setWebhook call and echoed back on every request for verification.
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=replace_me_with_a_random_string

# Real, free data sources this platform checks at startup
# (GET /v1/health/data-sources reports each one's configured/connected
# status honestly if left unset, rather than silently degrading).
DAHITI_API_KEY=replace_me  # https://dahiti.dgfi.tum.de
RELIEFWEB_APPNAME=replace_me  # https://apidoc.reliefweb.int/parameters#appname
GEMINI_API_KEY=replace_me  # AI Copilot (src/copilot/engine.py)

ALERT_THRESHOLD_MODERATE=30
ALERT_THRESHOLD_HIGH=50
ALERT_THRESHOLD_CRITICAL=70
ALERT_THRESHOLD_EXTREME=85

ALERT_COOLDOWN_MINUTES=30

# Optional - src/alerts/cooldown.py falls back to an in-memory cooldown
# (single-worker-safe only) if this isn't set or isn't reachable.
REDIS_URL=redis://localhost:6379/0
