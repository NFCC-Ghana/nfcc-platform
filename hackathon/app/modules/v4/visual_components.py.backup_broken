def render_economic_impact(
    residential: float,
    infrastructure: float,
    total: float,
    agriculture: float = None,
    currency: str = "GH₵"
) -> None:
    """
    Render a visual economic impact summary.
    Backward compatibility wrapper.
    """
    if agriculture is None:
        agriculture = 0
    
    max_value = max(residential, infrastructure, agriculture, 1)
    colors = {
        "Residential": THEME.DANGER,
        "Infrastructure": "#EA580C",
        "Agriculture": THEME.SUCCESS
    }
    
    st.markdown("### 💰 Estimated Economic Impact")
    col1, col2, col3 = st.columns(3)
    
    with col1:
        percentage = (residential / max_value) * 100 if max_value > 0 else 0
        display = format_currency(residential, currency)
        st.markdown(f"""
        <div style="background: {THEME.WHITE}; padding: {THEME.SPACE_12}px {THEME.SPACE_16}px; border-radius: {THEME.RADIUS_LG}; border-left: 4px solid {colors['Residential']};">
            <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500};">🏠 Residential</div>
            <div style="font-size: {THEME.FONT_XL}; font-weight: 700; color: {colors['Residential']};">{display}</div>
            {progress_bar(percentage, colors['Residential'], 4)}
        </div>
        """, unsafe_allow_html=True)
    
    with col2:
        percentage = (infrastructure / max_value) * 100 if max_value > 0 else 0
        display = format_currency(infrastructure, currency)
        st.markdown(f"""
        <div style="background: {THEME.WHITE}; padding: {THEME.SPACE_12}px {THEME.SPACE_16}px; border-radius: {THEME.RADIUS_LG}; border-left: 4px solid {colors['Infrastructure']};">
            <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500};">🏗️ Infrastructure</div>
            <div style="font-size: {THEME.FONT_XL}; font-weight: 700; color: {colors['Infrastructure']};">{display}</div>
            {progress_bar(percentage, colors['Infrastructure'], 4)}
        </div>
        """, unsafe_allow_html=True)
    
    with col3:
        if agriculture > 0:
            percentage = (agriculture / max_value) * 100 if max_value > 0 else 0
            display = format_currency(agriculture, currency)
        else:
            percentage = 0
            display = f"{currency} 0"
        st.markdown(f"""
        <div style="background: {THEME.WHITE}; padding: {THEME.SPACE_12}px {THEME.SPACE_16}px; border-radius: {THEME.RADIUS_LG}; border-left: 4px solid {colors['Agriculture']};">
            <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500};">🌾 Agriculture</div>
            <div style="font-size: {THEME.FONT_XL}; font-weight: 700; color: {colors['Agriculture']};">{display}</div>
            {progress_bar(percentage, colors['Agriculture'], 4)}
        </div>
        """, unsafe_allow_html=True)
    
    st.markdown("---")
    total_display = format_currency(total, currency)
    st.markdown(f"""
    <div style="background: linear-gradient(135deg, #1a1a2e, #16213e); padding: {THEME.SPACE_16}px {THEME.SPACE_24}px; border-radius: {THEME.RADIUS_LG}; text-align: center;">
        <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_400};">Total Estimated Impact</div>
        <div style="font-size: {THEME.FONT_3XL}; font-weight: 700; color: {THEME.WHITE};">{total_display}</div>
    </div>
    """, unsafe_allow_html=True)


