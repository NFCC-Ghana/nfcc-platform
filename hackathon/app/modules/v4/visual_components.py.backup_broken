    for shelter in shelters:
        status = shelter.get('status', 'OPEN')
        shelter_card = ShelterStatus(
            name=shelter.get('name', 'Unknown'),
            status=status,
            capacity=shelter.get('capacity', 0),
            available=shelter.get('available', 0)
        )
        shelter_card.render()

