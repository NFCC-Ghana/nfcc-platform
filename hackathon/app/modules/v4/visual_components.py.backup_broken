class RiskLevel(Enum):
    """Standardized risk levels."""
    CRITICAL = ("CRITICAL", THEME.RISK_CRITICAL, "🔴")
    HIGH = ("HIGH", THEME.RISK_HIGH, "🟠")
    MODERATE = ("MODERATE", THEME.RISK_MODERATE, "🟡")
    LOW = ("LOW", THEME.RISK_LOW, "🟢")
    
    @property
    def label(self) -> str:
        return self.value[0]
    
    @property
    def color(self) -> str:
        return self.value[1]
    
    @property
    def emoji(self) -> str:
        return self.value[2]

