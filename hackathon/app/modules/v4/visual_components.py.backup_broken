def render_horizontal_progress_bar(
    value: float,
    max_value: float = 100,
    label: str = "",
    color: str = None,
    height: int = 8,
    show_percentage: bool = True,
    show_emoji: bool = True
) -> None:
    """Backward compatibility wrapper for render_horizontal_progress_bar."""
    if color is None:
        color = THEME.SUCCESS
    
    pct = validate_percentage(value, max_value)
    emoji = "🟢" if pct >= 70 else "🟡" if pct >= 40 else "🔴"
    
    if label:
        if show_emoji:
            st.markdown(f"{emoji} **{escape(label)}**", unsafe_allow_html=True)
        else:
            st.markdown(f"**{escape(label)}**", unsafe_allow_html=True)
    
    st.markdown(progress_bar(pct, color, height), unsafe_allow_html=True)
    
    if show_percentage:
        st.caption(f"{pct:.0f}%")


