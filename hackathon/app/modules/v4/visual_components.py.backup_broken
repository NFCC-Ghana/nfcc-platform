def card(
    content: str,
    accent: str = None,
    shadow: str = "md",
    padding: int = None,
    background: str = None
) -> str:
    """
    Build a consistent card with optional accent border.
    
    Args:
        content: HTML content inside the card
        accent: Optional accent color for left border
        shadow: Shadow size (sm, md, lg, xl)
        padding: Custom padding (default: 16)
        background: Custom background color
    
    Returns:
        HTML string for the card
    """
    shadow_map = {
        "sm": THEME.SHADOW_SM,
        "md": THEME.SHADOW_MD,
        "lg": THEME.SHADOW_LG,
        "xl": THEME.SHADOW_XL,
    }
    border = f"border-left: 4px solid {accent};" if accent else ""
    pad = padding or THEME.SPACE_16
    bg = background or THEME.WHITE
    
    return f"""
    <div style="
        background: {bg};
        padding: {pad}px;
        border-radius: {THEME.RADIUS_LG};
        {border}
        box-shadow: {shadow_map.get(shadow, THEME.SHADOW_MD)};
        transition: transform {THEME.TRANSITION_FAST}, box-shadow {THEME.TRANSITION_FAST};
        margin-bottom: {THEME.SPACE_8}px;
    ">
        {content}
    </div>
    """

def progress_bar(
    percentage: float,
    color: str = None,
    height: int = 6,
    background: str = None,
    rounded: bool = True
) -> str:
    """
    Build a consistent progress bar.
    
    Args:
        percentage: Progress value (0-100)
        color: Bar color
        height: Bar height in pixels
        background: Background color
        rounded: Whether to use rounded corners
    
    Returns:
        HTML string for the progress bar
    """
    pct = validate_percentage(percentage)
    bar_color = color or THEME.SUCCESS
    bg = background or THEME.GRAY_100
    radius = THEME.RADIUS_FULL if rounded else THEME.RADIUS_SM
    
    return f"""
    <div style="
        width: 100%;
        background: {bg};
        border-radius: {radius};
        height: {height}px;
        overflow: hidden;
    ">
        <div style="
            width: {pct:.1f}%;
            background: {bar_color};
            height: {height}px;
            border-radius: {radius};
            transition: width {THEME.TRANSITION_SLOW};
        ">
        </div>
    </div>
    """

def metric_display(
    value: Union[int, float],
    label: str,
    emoji: str = "",
    color: str = None,
    subtitle: str = "",
    size: str = "large"
) -> str:
    """
    Build a consistent metric display.
    
    Args:
        value: The metric value
        label: Label text
        emoji: Optional emoji icon
        color: Value color
        subtitle: Optional subtitle
        size: Size variant (small, medium, large)
    """
    font_size_map = {
        "small": THEME.FONT_XL,
        "medium": THEME.FONT_2XL,
        "large": THEME.FONT_3XL,
    }
    fs = font_size_map.get(size, THEME.FONT_2XL)
    color_style = f"color: {color};" if color else ""
    
    return f"""
    <div style="display: flex; align-items: center; gap: {THEME.SPACE_12}px;">
        {f'<span style="font-size: {THEME.FONT_3XL}; line-height: 1;">{escape(emoji)}</span>' if emoji else ''}
        <div>
            <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500}; font-weight: 500;">
                {escape(label)}
            </div>
            <div style="font-size: {fs}; font-weight: 700; {color_style}">
                {format_number(value)}
            </div>
            {f'<div style="font-size: {THEME.FONT_XS}; color: {THEME.GRAY_400}; margin-top: {THEME.SPACE_4}px;">{escape(subtitle)}</div>' if subtitle else ''}
        </div>
    </div>
    """

def status_badge(
    status: Union[str, StatusType],
    label: str = None,
    show_icon: bool = True
) -> str:
    """
    Build an accessible status badge.
    
    Args:
        status: Status value or StatusType enum
        label: Optional custom label
        show_icon: Whether to show the icon
    
    Returns:
        HTML string for the status badge
    """
    if isinstance(status, StatusType):
        status_obj = status
    else:
        # Try to match string to StatusType
        try:
            status_obj = StatusType[status.upper()]
        except KeyError:
            status_obj = StatusType.INACTIVE
    
    display_label = label or status_obj.label
    color = status_obj.color
    emoji = status_obj.emoji if show_icon else ""
    
    return f"""
    <div style="
        display: inline-flex;
        align-items: center;
        gap: {THEME.SPACE_6}px;
        background: {THEME.GRAY_50};
        padding: {THEME.SPACE_4}px {THEME.SPACE_12}px;
        border-radius: {THEME.RADIUS_FULL};
        border: 1px solid {color};
    ">
        {f'<span aria-hidden="true">{emoji}</span>' if show_icon else ''}
        <span style="color: {color}; font-weight: 500; font-size: {THEME.FONT_SM};">
            {escape(display_label)}
        </span>
    </div>
    """

