    max_display: int = 5
) -> None:
    """Backward compatibility wrapper for render_affected_communities."""
    if not communities:
        st.info("No affected communities reported.")
        return
    
    # Simple severity distribution (alternating for visual variety)
    severity_pattern = ["MODERATE", "HIGH", "CRITICAL", "MODERATE", "LOW"]
    
    for i, community in enumerate(communities[:max_display]):
        severity = severity_pattern[i % len(severity_pattern)]
        community_card = AffectedCommunity(
            name=community,
            severity=severity
        )
        community_card.render()
    
    if len(communities) > max_display:
        st.caption(f"And {len(communities) - max_display} more communities affected...")

def render_risk_timeline_visual(
    hours: List[str],
    risks: List[float],
    current_risk: float
) -> None:
    """Backward compatibility wrapper for render_risk_timeline_visual."""
    for hour, risk in zip(hours, risks):
        level = RiskLevel.CRITICAL if risk >= 80 else RiskLevel.HIGH if risk >= 60 else RiskLevel.MODERATE if risk >= 40 else RiskLevel.LOW
        is_peak = risk == max(risks)
        is_current = risk == current_risk
        
        col1, col2 = st.columns([1, 4])
        with col1:
            st.markdown(
                f"<span style='color: {THEME.GRAY_900}; font-weight: bold;'>{escape(hour)}</span>",
                unsafe_allow_html=True
            )
        with col2:
            st.markdown(f"""
            <div style="display: flex; align-items: center; gap: {THEME.SPACE_8}px;">
                <span style="font-size: {THEME.FONT_MD};">{level.emoji}</span>
                {progress_bar(risk, level.color, 10)}
                <span style="font-size: {THEME.FONT_SM}; font-weight: {'700' if is_peak else '500'}; color: {level.color};">
                    {risk:.0f}%
                    {f' ⭐' if is_peak else ''}
                    {f' 👈' if is_current else ''}
                </span>
            </div>
            """, unsafe_allow_html=True)

def render_quick_stats(stats: List[Dict[str, Any]], columns: int = 4) -> None:
    """Backward compatibility wrapper for render_quick_stats."""
    cols = st.columns(columns)
    for i, stat in enumerate(stats):
