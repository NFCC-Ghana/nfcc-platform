@dataclass
class MetricCard:
    """
    A metric card with consistent styling.
    
    Example:
        card = MetricCard(
            value=187928,
            label="Total Population",
            emoji="👥",
            subtitle="Greater Accra Region"
        )
        card.render()
    """
    value: float
    label: str
    emoji: str = ""
    color: str = None
    subtitle: str = ""
    size: str = "large"
    shadow: str = "md"
    
    def render(self) -> None:
        """Render the metric card."""
        content = metric_display(
            value=self.value,
            label=self.label,
            emoji=self.emoji,
            color=self.color,
            subtitle=self.subtitle,
            size=self.size
        )
        st.markdown(
            card(content, accent=self.color, shadow=self.shadow),
            unsafe_allow_html=True
        )

@dataclass
class ProgressCard:
    """
    A progress card with label and bar.
    
    Example:
        card = ProgressCard(
            value=78,
            max_value=100,
            label="Soil Saturation",
            color=THEME.SUCCESS
        )
        card.render()
    """
    value: float
    max_value: float = 100
    label: str = ""
    emoji: str = ""
    color: str = None
    subtitle: str = ""
    height: int = 6
    
    def render(self) -> None:
        """Render the progress card."""
        pct = validate_percentage(self.value, self.max_value)
        bar_color = self.color or THEME.SUCCESS
        
        content = f"""
        <div>
            <div style="display: flex; align-items: center; gap: {THEME.SPACE_12}px; margin-bottom: {THEME.SPACE_8}px;">
                {f'<span style="font-size: {THEME.FONT_2XL};">{escape(self.emoji)}</span>' if self.emoji else ''}
                <div>
                    <div style="font-size: {THEME.FONT_MD}; font-weight: 600; color: {THEME.GRAY_800};">
                        {escape(self.label)}
                    </div>
                    <div style="font-size: {THEME.FONT_LG}; font-weight: 700; color: {bar_color};">
                        {pct:.0f}%
                    </div>
                </div>
            </div>
            {progress_bar(pct, bar_color, self.height)}
            {f'<div style="font-size: {THEME.FONT_XS}; color: {THEME.GRAY_400}; margin-top: {THEME.SPACE_4}px;">{escape(self.subtitle)}</div>' if self.subtitle else ''}
        </div>
        """
        st.markdown(card(content), unsafe_allow_html=True)

@dataclass
class RiskIndicator:
    """
    A risk indicator with color, label, and progress.
    
    Example:
        indicator = RiskIndicator(
            score=72,
            category="HIGH",
            show_progress=True
        )
        indicator.render()
    """
    score: float
    category: str = None
    show_progress: bool = True
    shadow: str = "md"
    
    def _get_risk_level(self) -> RiskLevel:
        """Get risk level based on score."""
        if self.score >= 80:
            return RiskLevel.CRITICAL
        if self.score >= 60:
            return RiskLevel.HIGH
        if self.score >= 40:
            return RiskLevel.MODERATE
        return RiskLevel.LOW
    
    def render(self) -> None:
        """Render the risk indicator."""
        level = self._get_risk_level()
        color = level.color
        emoji = level.emoji
        label = self.category or level.label
        
        content = f"""
        <div>
            <div style="display: flex; align-items: center; gap: {THEME.SPACE_16}px;">
                <span style="font-size: {THEME.FONT_4XL}; line-height: 1;">{emoji}</span>
                <div style="flex: 1;">
                    <div style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500}; font-weight: 500;">
                        Current Risk Level
                    </div>
                    <div style="font-size: {THEME.FONT_2XL}; font-weight: 700; color: {color};">
                        {self.score:.0f}% • {escape(label)}
                    </div>
                </div>
            </div>
            {f'<div style="margin-top: {THEME.SPACE_12}px;">{progress_bar(self.score, color)}</div>' if self.show_progress else ''}
        </div>
        """
        st.markdown(
            card(content, accent=color, shadow=self.shadow),
            unsafe_allow_html=True
        )

@dataclass
class ShelterStatus:
    """A shelter status card."""
    name: str
    status: Union[str, StatusType]
    capacity: int
    available: int
    
    def render(self) -> None:
        """Render the shelter status card."""
        occupied = self.capacity - self.available
        pct = (occupied / self.capacity) * 100 if self.capacity > 0 else 0
        
        if isinstance(self.status, StatusType):
            status_obj = self.status
        else:
            try:
                status_obj = StatusType[self.status.upper()]
            except KeyError:
                status_obj = StatusType.INACTIVE
        
        color = status_obj.color
        icon = status_obj.emoji
        label = status_obj.label
        
        content = f"""
        <div style="display: flex; align-items: center; gap: {THEME.SPACE_8}px; margin-bottom: {THEME.SPACE_8}px;">
            <span style="font-size: {THEME.FONT_MD};">{icon}</span>
            <span style="font-weight: 600; font-size: {THEME.FONT_MD}; color: {THEME.GRAY_900};">
                {escape(self.name)}
            </span>
            <span style="font-size: {THEME.FONT_SM}; color: {color}; font-weight: 500; margin-left: auto;">
                {escape(label)}
            </span>
        </div>
        <div style="display: flex; gap: {THEME.SPACE_16}px; font-size: {THEME.FONT_SM}; color: {THEME.GRAY_600}; margin-bottom: {THEME.SPACE_8}px;">
            <span>👤 <span style="color: {THEME.GRAY_900}; font-weight: 600;">{occupied:,}</span> occupied</span>
            <span>🏠 <span style="color: {THEME.GRAY_900}; font-weight: 600;">{self.available:,}</span> available</span>
            <span>📊 <span style="color: {THEME.GRAY_900}; font-weight: 600;">{pct:.0f}%</span> full</span>
        </div>
        {progress_bar(pct, color, 4)}
        """
        st.markdown(
            card(content, accent=color, shadow="sm", padding=THEME.SPACE_12),
            unsafe_allow_html=True
        )

