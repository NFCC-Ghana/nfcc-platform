def format_number(value: float, decimals: int = 1) -> str:
    """
    Format numbers with K, M, B suffixes.
    
    Args:
        value: Number to format
        decimals: Number of decimal places
    
    Returns:
        Formatted string like "1.5K", "2.3M", "1.2B"
    """
    if value is None:
        return "0"
    if value >= 1_000_000_000:
        return f"{value/1e9:.{decimals}f}B"
    if value >= 1_000_000:
        return f"{value/1e6:.{decimals}f}M"
    if value >= 1_000:
        return f"{value/1e3:.{decimals}f}K"
    return f"{value:,.0f}"

def format_currency(value: float, currency: str = "GH₵") -> str:
    """Format currency with proper suffixes."""
    if value is None or value == 0:
        return f"{currency} 0"
    if value >= 1_000_000_000:
        return f"{currency} {value/1e9:.2f}B"
    if value >= 1_000_000:
        return f"{currency} {value/1e6:.1f}M"
    if value >= 1_000:
        return f"{currency} {value/1e3:.1f}K"
    return f"{currency} {value:,.0f}"

def format_percentage(value: float, decimals: int = 0) -> str:
    """Format percentage with optional decimals."""
    return f"{value:.{decimals}f}%"

def format_compact(value: Union[int, float]) -> str:
    """
    Compact number formatting for display in cards.
    Uses K for thousands, M for millions.
    """
    if value is None:
        return "0"
    if value >= 1_000_000:
        return f"{value/1_000_000:.1f}M"
    if value >= 10_000:
        return f"{value/1_000:.1f}K"
    return f"{value:,.0f}"

# ============================================================
# SECTION 4: VALIDATORS (Input Safety)
# ============================================================

def validate_percentage(value: float, max_value: float = 100) -> float:
    """Validate and clamp percentage between 0 and max_value."""
    if max_value <= 0:
        raise ValueError(f"max_value must be > 0, got {max_value}")
    return max(0, min(max_value, value))

def validate_risk_score(score: float) -> float:
    """Validate risk score is between 0-100."""
    if not 0 <= score <= 100:
        raise ValueError(f"Risk score must be between 0-100, got {score}")
    return score

def validate_positive(value: float, name: str = "Value") -> float:
    """Validate value is positive."""
    if value < 0:
        raise ValueError(f"{name} must be non-negative, got {value}")
    return value

