# These wrapper functions maintain backward compatibility
# while using the new enterprise components

def render_visual_metric_card(
    value: float,
    label: str,
    emoji: str = "",
    color: str = None,
    max_value: float = 100,
    subtitle: str = "",
    show_bar: bool = True
) -> None:
    """Backward compatibility wrapper for render_visual_metric_card."""
    if not color:
        # Determine color based on percentage
        pct = (value / max_value) * 100 if max_value > 0 else 0
        if pct >= 70:
            color = THEME.SUCCESS
        elif pct >= 40:
            color = THEME.WARNING
        else:
            color = THEME.DANGER
    
    if show_bar:
        card = ProgressCard(
            value=value,
            max_value=max_value,
            label=label,
            emoji=emoji,
            color=color,
            subtitle=subtitle
        )
        card.render()
    else:
        card = MetricCard(
            value=value,
            label=label,
            emoji=emoji,
            color=color,
            subtitle=subtitle,
            size="large"
        )
        card.render()

def render_risk_indicator(
    risk_score: float,
    risk_category: str,
    show_progress: bool = True
) -> None:
    """Backward compatibility wrapper for render_risk_indicator."""
    indicator = RiskIndicator(
