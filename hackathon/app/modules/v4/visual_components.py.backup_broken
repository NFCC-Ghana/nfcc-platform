def render_metric_card(
    value: Any,
    label: str,
    emoji: str = "",
    change: Optional[float] = None,
    change_label: str = "",
    color: str = None,
    size: str = "medium"
) -> None:
    """Backward compatibility wrapper for render_metric_card."""
    if color is None:
        color = THEME.GRAY_700
    
    if change is not None:
        change_color = THEME.SUCCESS if change >= 0 else THEME.DANGER
        arrow = "↑" if change >= 0 else "↓"
        change_html = f"""
            <div style="text-align: right;">
                <span style="color: {change_color}; font-weight: 600; font-size: {THEME.FONT_MD};">
                    {arrow} {abs(change):.1f}%
                </span>
                <div style="font-size: {THEME.FONT_XS}; color: {THEME.GRAY_500};">{escape(change_label)}</div>
            </div>
        """
    else:
        change_html = ""
    
    display_value = format_number(value) if isinstance(value, (int, float)) else str(value)
    
    st.markdown(f"""
    <div style="
        background: {THEME.WHITE};
        padding: {THEME.SPACE_16}px;
        border-radius: {THEME.RADIUS_LG};
        box-shadow: {THEME.SHADOW_MD};
        border-left: 4px solid {color};
        margin-bottom: {THEME.SPACE_8}px;
    ">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div>
                <span style="font-size: {THEME.FONT_SM}; color: {THEME.GRAY_500}; font-weight: 500;">{escape(label)}</span>
                <div style="font-size: {THEME.FONT_XL}; font-weight: 700; color: {color};">
                    {escape(emoji)} {display_value}
                </div>
            </div>
            {change_html}
        </div>
    </div>
    """, unsafe_allow_html=True)


