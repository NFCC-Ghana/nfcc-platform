# ============================================================
# NFCC PLATFORM - PRODUCTION DOCKERFILE
# ============================================================
# Multi-stage build for smaller production image

# ============================================================
# STAGE 1: Builder
# ============================================================
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies to a temporary location
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --user -r requirements.txt && \
    pip install --no-cache-dir --user twilio python-dotenv joblib

# ============================================================
# STAGE 2: Runtime
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Litestream binary (see litestream.yml, entrypoint.sh) - replicates the
# two local SQLite databases to GCS so they survive Cloud Run's
# ephemeral container storage across deploys and scale-to-zero restarts.
COPY --from=litestream/litestream:0.5.17 /usr/local/bin/litestream /usr/local/bin/litestream

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p logs data/processed reports/coverage

RUN chmod +x entrypoint.sh

# Expose port
EXPOSE 8080

# Health check configuration
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run via Litestream so the app's SQLite writes get replicated - see
# entrypoint.sh for the real startup command (still expands $PORT the
# same way the old direct `CMD uvicorn ...` did, just from inside the
# script instead of Docker's shell form).
CMD ["/app/entrypoint.sh"]
